{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prisma-crypto",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prisma-crypto-state",
      "database_id": "d9f2162c-6f94-47d2-9770-ab6f961228d7"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CRYPTO_HUB",
        "class_name": "CryptoHub"
      }
    ]
  },
  "exports": {
    "CryptoHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
