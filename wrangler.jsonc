{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prisma-crypto",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CRYPTO_HUB",
        "class_name": "CryptoHub"
      }
    ]
  },
  "exports": {
    "CryptoHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
